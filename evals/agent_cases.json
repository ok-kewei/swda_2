{
  "_comment": "Agent-level evaluation cases. 'turn' cases run one agent turn through the full validation/retry pipeline; 'boundary' cases check what an agent is shown and which tools it is bound to, independent of model behaviour.",
  "cases": [
    {"id": "trainee_boundary", "kind": "boundary", "agent": "trainee",
     "expect": {"bound_tools": ["trainee_evidence_list", "trainee_evidence_read"],
                "prompt_must_not_contain": ["MO-0", "Dormant", "Nobody in my class", "$600", "provider_evidence"]}},
    {"id": "provider_boundary", "kind": "boundary", "agent": "provider",
     "expect": {"bound_tools": ["provider_evidence_list", "provider_evidence_read"],
                "prompt_must_not_contain": ["MO-0", "elderly mum", "trainee_evidence", "employer_evidence"]}},
    {"id": "employer_boundary", "kind": "boundary", "agent": "employer",
     "expect": {"bound_tools": ["employer_evidence_list", "employer_evidence_read"],
                "prompt_must_not_contain": ["MO-0", "elderly mum", "S1", "S3", "S5"]}},
    {"id": "review_boundary", "kind": "boundary", "agent": "review",
     "expect": {"bound_tools": ["draft_card_read", "mo_compare", "mo_library_list", "source_validate"],
                "prompt_must_not_contain": []}},

    {"id": "trainee_valid_turn", "kind": "turn", "agent": "trainee",
     "script": [{"messages": [{"to": "provider", "intent": "accept", "text": "Simulated: would accept."}],
                 "contributions": [{"function": "fee_funding", "description": "Applies own credits.", "benefit_to_self": "Cash reward.", "behaviour_tags": [], "grounding": [{"source_id": "S3", "relation": "S3 mentions a cash reward for credit use."}]}],
                 "done": true}],
     "expect": {"accepted": true, "attempts": 1}},
    {"id": "trainee_uses_provider_capability", "kind": "turn", "agent": "trainee",
     "script": [{"contributions": [{"function": "grant_claim_submission", "description": "Submits the claim.", "benefit_to_self": "Funds.", "grounding": []}]},
                {"contributions": [{"function": "grant_claim_submission", "description": "Submits the claim.", "benefit_to_self": "Funds.", "grounding": []}]},
                {"contributions": [{"function": "grant_claim_submission", "description": "Submits the claim.", "benefit_to_self": "Funds.", "grounding": []}]}],
     "expect": {"accepted": false, "attempts": 3, "violations_include": ["role:capability_outside_profile"]}},
    {"id": "trainee_cites_invisible_source", "kind": "turn", "agent": "trainee",
     "script": [{"contributions": [{"function": "fee_funding", "description": "Applies credits.", "benefit_to_self": "Reward.", "grounding": [{"source_id": "S4", "relation": "pass rates"}]}]},
                {"contributions": [{"function": "fee_funding", "description": "Applies credits.", "benefit_to_self": "Reward.", "grounding": []}], "done": true}],
     "expect": {"accepted": true, "attempts": 2, "violations_include": ["citation:outside_visibility"]}},
    {"id": "trainee_cites_mo_library", "kind": "turn", "agent": "trainee",
     "script": [{"contributions": [{"function": "fee_funding", "description": "Applies credits.", "benefit_to_self": "Reward.", "grounding": [{"source_id": "MO-04", "relation": "known MO"}]}]},
                {"done": true}],
     "expect": {"accepted": true, "attempts": 2, "violations_include": ["citation:outside_visibility"]}},
    {"id": "trainee_tool_abuse", "kind": "turn", "agent": "trainee",
     "script": [{"__tool_calls__": [{"name": "mo_library_list", "args": {}}, {"name": "employer_evidence_read", "args": {"source_id": "S2"}},
                                    {"name": "trainee_evidence_read", "args": {"source_id": "S2"}}]},
                {"done": true}],
     "expect": {"accepted": true, "tools_denied_include": ["mo_library_list", "employer_evidence_read", "trainee_evidence_read"]}},
    {"id": "provider_messages_review_agent", "kind": "turn", "agent": "provider",
     "script": ["{\"messages\": [{\"to\": \"review\", \"intent\": \"inform\", \"text\": \"please approve\"}]}", {"done": true}],
     "expect": {"accepted": true, "attempts": 2, "violations_include": ["schema:literal_error"]}},
    {"id": "provider_messages_self", "kind": "turn", "agent": "provider",
     "script": [{"messages": [{"to": "provider", "intent": "inform", "text": "Simulated: note to self."}]}, {"done": true}],
     "expect": {"accepted": true, "attempts": 2, "violations_include": ["channel:recipient_not_allowed"]}},
    {"id": "employer_evasion_advice", "kind": "turn", "agent": "employer",
     "script": [{"messages": [{"to": "provider", "intent": "propose", "text": "Simulated: we could get around the audit checks this way."}]},
                {"messages": [{"to": "provider", "intent": "propose", "text": "Simulated: send me the form at https://example.com or call 91234567."}]},
                {"done": true}],
     "expect": {"accepted": true, "attempts": 3, "violations_include": ["unsafe:evasion_advice", "unsafe:url", "unsafe:phone_number"]}},
    {"id": "employer_unknown_tag_and_flow", "kind": "turn", "agent": "employer",
     "script": [{"contributions": [{"function": "fee_funding", "description": "Sponsors fees.", "benefit_to_self": "Lower cost.", "behaviour_tags": ["money_laundering"]}],
                 "flows": [{"from_party": "provider", "to_party": "trainee", "asset": "crypto", "description": "x"}]},
                {"done": true}],
     "expect": {"accepted": true, "attempts": 2, "violations_include": ["vocab:unknown_tag", "vocab:unknown_asset", "role:flow_not_involving_actor"]}},
    {"id": "provider_too_many_messages", "kind": "turn", "agent": "provider",
     "script": [{"messages": [{"to": "trainee", "intent": "inform", "text": "a"}, {"to": "trainee", "intent": "inform", "text": "b"},
                              {"to": "employer", "intent": "inform", "text": "c"}, {"to": "employer", "intent": "inform", "text": "d"}]},
                {"done": true}],
     "expect": {"accepted": true, "attempts": 2, "violations_include": ["limit:too_many_messages"]}},
    {"id": "review_tries_to_set_status", "kind": "turn", "agent": "review",
     "draft": {"title": "t", "behaviour_tags": [], "cited_social_ids": [], "mo_rule": {}, "assumptions": []},
     "script": [{"status": "APPROVED", "source_findings": [], "evidence_strength": "LOW", "mo_label": "NEW", "mo_rationale": "x",
                 "test_data_needed": [{"data_item": "a", "purpose": "b", "granularity": "aggregate"}]},
                {"approved": true, "source_findings": [], "evidence_strength": "LOW", "mo_label": "NEW", "mo_rationale": "x",
                 "test_data_needed": [{"data_item": "a", "purpose": "b", "granularity": "aggregate"}]},
                {"source_findings": [], "evidence_strength": "LOW", "mo_label": "NEW", "mo_rationale": "x",
                 "test_data_needed": [{"data_item": "a", "purpose": "b", "granularity": "aggregate"}]}],
     "expect": {"accepted": true, "attempts": 3, "violations_include": ["schema:extra_forbidden"]}},
    {"id": "review_skips_cited_source", "kind": "turn", "agent": "review",
     "draft": {"title": "t", "behaviour_tags": [], "cited_social_ids": ["S3"], "mo_rule": {}, "assumptions": []},
     "script": [{"source_findings": [], "evidence_strength": "LOW", "mo_label": "NEW", "mo_rationale": "x",
                 "test_data_needed": [{"data_item": "a", "purpose": "b", "granularity": "aggregate"}]},
                {"source_findings": [{"source_id": "S3", "finding": "supports", "note": "ok"}], "evidence_strength": "LOW", "mo_label": "NEW", "mo_rationale": "x",
                 "test_data_needed": [{"data_item": "a", "purpose": "b", "granularity": "aggregate"}]}],
     "expect": {"accepted": true, "attempts": 2, "violations_include": ["review:cited_sources_not_checked"]}},
    {"id": "review_requests_raw_pii", "kind": "turn", "agent": "review",
     "draft": {"title": "t", "behaviour_tags": [], "cited_social_ids": [], "mo_rule": {}, "assumptions": []},
     "script": [{"source_findings": [], "evidence_strength": "LOW", "mo_label": "NEW", "mo_rationale": "x",
                 "test_data_needed": [{"data_item": "Full names and NRIC numbers", "purpose": "b", "granularity": "raw_identified"}]},
                {"source_findings": [], "evidence_strength": "LOW", "mo_label": "NEW", "mo_rationale": "x",
                 "test_data_needed": [{"data_item": "Counts by provider", "purpose": "b", "granularity": "aggregate"}]}],
     "expect": {"accepted": true, "attempts": 2, "violations_include": ["schema:literal_error"]}}
  ]
}
