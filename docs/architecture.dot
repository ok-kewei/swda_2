digraph arch {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.55, compound=true, newrank=true,
         label=<<b>SWDA collusion-pattern PoC: data &amp; control flows</b><br/><font point-size="9">solid = control · dashed = data · dotted = trace/audit · red = trust boundary</font>>, labelloc=t];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#555555"];
  edge  [fontname="Helvetica", fontsize=8, color="#444444"];

  subgraph cluster_inputs {
    label=<<b>Untrusted inputs</b>>; style="dashed,rounded"; color="#c0392b"; fontcolor="#c0392b";
    annexA [label="Annex A\nMO library", fillcolor="#fdecea"];
    annexB [label="Annex B\nsocial excerpts", fillcolor="#fdecea"];
    extra  [label="Red-team extra\nsources", fillcolor="#fdecea"];
  }
  subgraph cluster_cfg {
    label=<<b>Versioned config (hashed into trace)</b>>; style=rounded; color="#999999";
    cfg [label="actors.json · taxonomy.json\nmo_feature_tags.json · limits.json", shape=note, fillcolor="#f5f5f5"];
  }

  ingest [label="Sanitise + injection scan\n(hidden Unicode, override, role hijack,\nduplicate IDs) → quarantine", fillcolor="#fff4e5"];
  store  [label="SourceStore\n(quarantined text never served)", shape=cylinder, fillcolor="#fff4e5"];

  subgraph cluster_graph {
    label=<<b>LangGraph StateGraph</b>  (SqliteSaver checkpointer, thread_id = run_id)>; style=rounded; color="#2c3e50"; bgcolor="#f7f9fb";

    orch [label=<<b>orchestrator</b> (hub)<br/><font point-size="8">routes messages · channel policy · injection re-scan<br/>picks speaker · round / call / cost limits</font>>, fillcolor="#dfe9f3"];

    subgraph cluster_rounds {
      label=<<b>Simulation rounds</b> (≤ max_rounds)>; style="rounded"; color="#7f8c8d"; bgcolor="#ffffff";
      trainee  [label=<<b>Trainee Agent</b><br/><font point-size="8">sees S1 S3 S5 · tools: trainee_evidence_*</font>>, fillcolor="#e8f6ef"];
      provider [label=<<b>Training Provider Agent</b><br/><font point-size="8">sees S1 S2 S4 · tools: provider_evidence_*</font>>, fillcolor="#e8f6ef"];
      employer [label=<<b>Employer Agent</b><br/><font point-size="8">sees S2 S4 · tools: employer_evidence_*</font>>, fillcolor="#e8f6ef"];
    }

    validator [label="Turn validator + retries\nschema (extra=forbid) · role capability\ncitation scope · vocab · safety guard", fillcolor="#fef9e7"];
    gateway   [label="ToolGateway\nper-agent allow-list + scope\n(denials traced)", fillcolor="#fef9e7"];

    assemble [label=<<b>assemble</b> (deterministic)<br/><font point-size="8">actor-removal check · single-actor vs collusion<br/>MO rule classification</font>>, fillcolor="#dfe9f3"];
    review   [label=<<b>Review Agent</b><br/><font point-size="8">read-only: source_validate · mo_library_list<br/>mo_compare · draft_card_read · cannot approve</font>>, fillcolor="#e8f6ef"];
    finalize [label=<<b>finalize</b><br/><font point-size="8">evidence rules (≤ MODERATE) · checks · flags<br/>PatternCard schema · content hash</font>>, fillcolor="#dfe9f3"];
    approval [label=<<b>human_approval</b><br/><font point-size="8">interrupt() · validate · re-interrupt on error</font>>, fillcolor="#fde2c8", color="#d35400", penwidth=2];
    record   [label="record_decision", fillcolor="#dfe9f3"];
    halt     [label="halt\n(limit breach → handoff.md)", fillcolor="#f9d6d5"];
  }

  human [label="Human reviewer\n`main.py decide`\n(named identity, reason, card hash)", shape=box, style="filled", fillcolor="#fde2c8", color="#d35400", penwidth=2];

  subgraph cluster_store {
    label=<<b>Trace &amp; persistence</b>>; style=rounded; color="#999999";
    trace  [label="trace.jsonl\nhash-chained events", shape=cylinder, fillcolor="#eeeeee"];
    ckpt   [label="checkpoints.sqlite", shape=cylinder, fillcolor="#eeeeee"];
    cards  [label="card.json / card.md\ndecision.json", shape=cylinder, fillcolor="#eeeeee"];
    dlog   [label="decisions.jsonl\nhash-chained", shape=cylinder, fillcolor="#eeeeee"];
  }

  subgraph cluster_eval {
    label=<<b>Evaluation harness</b>  (`main.py eval`, pytest)>; style=rounded; color="#8e44ad";
    agentev [label="Agent-level cases\nboundary + turn", fillcolor="#f4ecf7"];
    e2e     [label="End-to-end\ninvariants (any model)\n+ golden expectations (mock)", fillcolor="#f4ecf7"];
    regr    [label="Regression\ngolden card snapshots", fillcolor="#f4ecf7"];
    mock    [label="Scripted mock LLM\nper agent\n(GenericFakeChatModel)", fillcolor="#f4ecf7"];
  }

  annexA -> ingest [style=dashed]; annexB -> ingest [style=dashed]; extra -> ingest [style=dashed];
  ingest -> store [style=dashed];
  cfg -> orch [style=dashed, lhead=cluster_graph, label="profiles, limits"];

  orch -> trainee [label="turn"]; orch -> provider [label="turn"]; orch -> employer [label="turn"];
  trainee -> validator [style=dashed, label="proposal"]; provider -> validator [style=dashed]; employer -> validator [style=dashed];
  validator -> orch [label="accepted turn\n(outbox)"];
  trainee -> gateway [style=dashed, dir=both]; provider -> gateway [style=dashed, dir=both]; employer -> gateway [style=dashed, dir=both];
  gateway -> store [style=dashed, label="scoped read"];
  orch -> assemble [label="rounds done"];
  orch -> halt [label="limit hit", color="#c0392b"];
  assemble -> review;
  review -> gateway [style=dashed, dir=both];
  review -> finalize [label="ReviewOutput\n(no status field)"];
  finalize -> approval;
  approval -> human [dir=both, xlabel="pause ⇄ Command(resume)", color="#d35400", penwidth=2];
  approval -> record;
  finalize -> cards [style=dashed]; record -> cards [style=dashed]; record -> dlog [style=dotted];

  orch -> trace [style=dotted, color="#888888", ltail=cluster_graph, xlabel="all events"];
  orch -> ckpt [style=dotted, color="#888888", ltail=cluster_graph];

  mock -> trainee [style=dashed, color="#8e44ad", lhead=cluster_rounds];
  e2e -> orch [color="#8e44ad", lhead=cluster_graph, label="runs scenarios"];
  e2e -> trace [style=dashed, color="#8e44ad", dir=back];
  regr -> cards [style=dashed, color="#8e44ad", dir=back];
  agentev -> validator [color="#8e44ad"];
}
